# Dependencies
node_modules/

# Build output
dist/
.astro/
.output/

# Deploy / env
.vercel/
.env
.env.*
!.env.example

# Third-party clone — not our code. See README (Perception-First Design).
perception-first-design/

# Local-only editor + agent settings
.claude/settings.local.json

# Raw video masters dropped in the repo root. The web-ready encodes in
# web/public/media/ ARE tracked; these originals are tens of MB each and belong
# in asset storage rather than git history.
/*.mp4
/*.mov

# Mobile audit artifacts — ~170 full-page PNGs per run plus the pixel diffs.
# The findings live in docs/mobile-audit.md; the images are reproducible with
# `npm run audit:mobile` and don't belong in history.
web/.mobile-audit/

# OS / WSL cruft
.DS_Store
*:Zone.Identifier
