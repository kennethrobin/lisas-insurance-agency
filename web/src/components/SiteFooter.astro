---
/**
 * Sitewide footer. Quick links render from `footerNav` in site.ts, so the
 * footer can never drift out of sync with the menu above it.
 *
 * The TPMO disclaimers ship verbatim on every page — they are the generic,
 * no-numbers wording, which stays accurate however many plans Lisa represents.
 */
import { site, footerNav, legalNav } from '../data/site';
import { links, isPending, externalAttrs } from '../data/links';
import Logo from './Logo.astro';

const reviewLinks = [
  { label: 'Google', href: links.reviewGoogle },
  { label: 'Facebook', href: links.reviewFacebook },
  { label: 'X', href: links.reviewX },
].filter((link) => !isPending(link.href));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="wordmark"><Logo /></p>
        <p class="mission">
          A licensed advisor by your side, year after year.
        </p>

        <div class="footer-contact">
          {/* Inline SVG, not a ☎ character: the self-hosted font is a latin
              subset with no symbol glyphs, so it fell back to whichever system
              font had one — and on some platforms that is a colour emoji. */}
          <a href={site.phoneHref}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.6 10.8a15.3 15.3 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/>
            </svg>
            {site.phone}
          </a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>Hours: 10:00 AM – 7:00 PM CST</span>
          <p class="microline">Calling connects you with Lisa, a licensed insurance agent.</p>
        </div>
      </div>

      {/* Native disclosures start closed, including before JS and without JS.
          The script expands them into static desktop columns. Contact details
          and insurance disclosures are never collapsed. */}
      <nav class="footer-col" aria-label="Quick links">
        <details class="footer-group">
          <summary><h3>Quick links</h3></summary>
          <ul>
            {footerNav.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
            <li><a href="/medicare/education">Blog</a></li>
          </ul>
        </details>
      </nav>

      <nav class="footer-col" aria-label="Get started">
        <details class="footer-group">
          <summary>
            <h3><span class="footer-desktop-label">Ready to explore your options? Start Here</span><span class="footer-mobile-label">Get started</span></h3>
          </summary>
          <ul>
            {/* "Policyholder Service" removed at the owner's request. The
                /policyholders page still exists but is no longer linked here.
                That decision post-dates the mobile pass, so this column keeps
                the single link — only the accordion wrapper came across.
                DEFERRED: no auth/CRM is built. While profileSignup is "#" this
                points at the contact page, where Lisa can set someone up by hand
                — a link that goes nowhere would be worse than one extra step. */}
            <li>
              <a href={isPending(links.profileSignup) ? '/contact' : links.profileSignup}>
                Create a profile
              </a>
            </li>
          </ul>
        </details>
      </nav>
    </div>

    {reviewLinks.length > 0 && (
      <p class="footer-review-row">
        <span class="mark" aria-hidden="true">★</span> Leave a review:
        {reviewLinks.map((link, i) => (
          <>
            {i > 0 && ' · '}
            <a href={link.href} {...externalAttrs}>{link.label}</a>
          </>
        ))}
      </p>
    )}

    <div class="footer-disclaimers">
      <h3 class="footer-disclosures-heading">Insurance disclosures</h3>
      <p>
        We do not offer every plan available in your area. Any information we
        provide is limited to those plans we do offer in your area. Please contact
        Medicare.gov or 1-800-MEDICARE to get information on all of your options.
      </p>
      <p>
        Not affiliated with or endorsed by the U.S. government or the federal
        Medicare program.
      </p>
      <p>
        Secure online dental enrollment is available in 43 states. Coverage is
        currently unavailable in CT, VT, UT, HI, WY, WV, and RI.
      </p>
      {/* Agent licence line. Renders only once site.license is filled in, so
          nothing placeholder ships in this compliance-sensitive spot. */}
      {(site.license.statement || site.license.npn) && (
        <p>
          {site.license.statement}
          {site.license.statement && site.license.npn && ' · '}
          {site.license.npn && <>National Producer Number {site.license.npn}</>}
        </p>
      )}
    </div>

    <div class="footer-legal">
      {legalNav.map((link) => <a href={link.href}>{link.label}</a>)}
      <span>© {site.name}</span>
    </div>
  </div>
</footer>

<script>
  const groups = document.querySelectorAll<HTMLDetailsElement>('.footer-group');
  const wide = window.matchMedia('(min-width: 768px)');
  groups.forEach((group) => {
    const summary = group.querySelector('summary');
    let mobileOpen = false;
    const sync = () => {
      if (wide.matches) {
        mobileOpen = group.open;
        group.open = true;
        group.dataset.static = '';
        summary?.setAttribute('tabindex', '-1');
      } else {
        group.open = mobileOpen;
        delete group.dataset.static;
        summary?.removeAttribute('tabindex');
      }
    };
    wide.addEventListener('change', sync);
    sync();
  });
</script>
