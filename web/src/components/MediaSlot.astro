---
/**
 * A gradient panel standing in for a photograph that doesn't exist yet.
 *
 * Deliberately a designed object rather than a grey box: these ship to a real
 * preview that Lisa will look at, and a grey box reads as something broken.
 * The caption states what belongs here so the shot list writes itself.
 */
interface Props {
  /** What photo goes here, in plain words. Shown on the panel. */
  label: string;
  /** CSS aspect-ratio, e.g. "4 / 3", "16 / 9", "1 / 1". */
  ratio?: string;
}
const { label, ratio = '4 / 3' } = Astro.props;
---

<figure class="media-slot" style={`--slot-ratio: ${ratio}`} role="img" aria-label={`Image placeholder: ${label}`}>
  <span class="slot-mark" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="3" y="4" width="18" height="16" rx="2.5" />
      <circle cx="8.5" cy="9.5" r="1.75" />
      <path d="M3.5 17.5 9 12l4 3.5 3-2.5 4.5 4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <p>Photo pending — {label}</p>
</figure>
