---
/**
 * The closing panel. Repeats the hero's warm field so a page opens and shuts on
 * the same note, exactly as the homepage does.
 *
 * "Schedule a call" resolves through links.ts: with a booking URL it links
 * there, without one it becomes the tap-to-call action. Either way it works.
 */
import { site } from '../data/site';
import { links, isPending, scheduleCta, externalAttrs } from '../data/links';

interface Props {
  heading: string;
  /** One sentence under the heading. */
  copy?: string;
  /** Show the "Schedule a call" secondary. */
  schedule?: boolean;
  id?: string;
}
const { heading, copy, schedule = true, id = 'contact' } = Astro.props;
const booking = scheduleCta(site.phoneHref);

/* No endpoint yet = no form. Same rule the newsletter already follows: taking
   details you cannot store is worse than not asking for them. */
const formPending = isPending(links.contactEndpoint);
---

<section class="section cta-band" id={id} aria-labelledby={`${id}-heading`}>
  <div class="container">
    <p class="eyebrow">Get in touch</p>

    <div class="cta-grid">
      <div class="cta-copy">
        <h2 id={`${id}-heading`}>{heading}</h2>
        {copy && <p class="lead">{copy}</p>}
        <div class="actions actions--stack">
          <a class="btn btn--accent" href={site.phoneHref}>Talk to Lisa · {site.phone}</a>
          <a class="btn btn--ghost" href={site.smsHref}>Text me</a>
          {schedule && (
            <a
              class="btn btn--ghost"
              href={booking.href}
              {...(booking.external ? externalAttrs : {})}
            >
              {booking.label}
            </a>
          )}
        </div>
        <p class="microline">Calling connects you with Lisa, a licensed insurance agent.</p>
      </div>

      <div class="contact-card">
        {formPending ? (
          /* TODO: links.contactEndpoint. No endpoint, no form — see links.ts for
             why. The visitor gets the route that actually reaches Lisa today
             instead of a form that swallows their details. */
          <div class="contact-note">
            <h3>Sending me a note</h3>
            <p>
              The note form isn’t connected to my inbox yet. I’d rather tell you
              that than take your name and number and lose them — so here are the
              two ways that reach me today.
            </p>
            <div class="actions">
              <a class="btn btn--accent" href={site.phoneHref}>Call · {site.phone}</a>
              <a class="btn btn--ghost" href={site.smsHref}>Text me</a>
            </div>
          </div>
        ) : (
          <>
            <h3>Or send me a note</h3>

            {/* A plain POST, not fetch(): the endpoint is a third party, so a
                form submission works regardless of its CORS policy. It should
                redirect to /thank-you on success. */}
            <form class="contact-form" action={links.contactEndpoint} method="post">
              <div>
                <label for={`${id}-name`}>Name</label>
                <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
              </div>
              <div>
                <label for={`${id}-phone`}>Phone</label>
                <input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
              </div>
              <div>
                <label for={`${id}-topic`}>What can I help with?</label>
                <select id={`${id}-topic`} name="topic">
                  <option value="medicare">Medicare</option>
                  <option value="health">Health insurance (under 65)</option>
                  <option value="dental">Dental &amp; vision</option>
                  <option value="other">Something else</option>
                </select>
              </div>
              <button class="btn btn--accent" type="submit">Send</button>
            </form>
          </>
        )}
      </div>
    </div>
  </div>
</section>

{/* No script. The form used to intercept its own submit, discard the data and
    fake a success message; there is nothing left to intercept. Once
    links.contactEndpoint is real the browser posts to it natively, which also
    means the form works with JS disabled. */}
