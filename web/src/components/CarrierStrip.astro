---
/**
 * Rolling strip of carrier partners.
 *
 * Each chip shows the carrier's own logo in its real colours on a white
 * capsule (owner's request, 2026-10). Files live in /public/logos/carriers and come
 * from the carriers' official sites (see docs/carrier-logos.md). A carrier without
 * a `logo` falls back to its name as text.
 *
 * The list is duplicated in the markup and the track is translated by exactly
 * half its width, which is what makes the loop seamless. Under reduced motion
 * the animation stops and the clones hide, leaving a plain wrapped row.
 */
export type Carrier = {
  name: string;
  note?: string;
  /** White logo under /public, e.g. '/logos/carriers/aetna.svg'. */
  logo?: string;
  /** Height multiplier for tall marks whose wordmark would otherwise read small. */
  logoScale?: number;
};
import MotionPreferences from './MotionPreferences.astro';

interface Props {
  /** Optional label above this lane, e.g. "Enroll online". */
  label?: string;
  carriers: Carrier[];
  /** Roll the other way — useful when two lanes sit together. */
  reverse?: boolean;
}
const { label, carriers, reverse = false } = Astro.props;
/* The loop renders the list twice; the second copy is marked as the clone. */
const halves = [false, true];
---

<div class:list={['carrier-lane', { 'carrier-lane--reverse': reverse }]}>
  {label && <p class="carrier-lane-label">{label}</p>}
  <MotionPreferences />

  <div class="carrier-strip">
    {/* The list is decorative repetition of names already in the page copy, so
        the whole strip is hidden from assistive tech — a screen reader hearing
        every carrier twice is noise, not information. */}
    <div class="carrier-track" aria-hidden="true">
      {/* The duplicate half carries `data-clone` so reduced motion can drop it.
          alt is empty because the whole track is aria-hidden. */}
      {halves.map((clone) => carriers.map((carrier) => (
        <span class:list={['carrier-chip', { 'carrier-chip--logo': carrier.logo }]} data-clone={clone || undefined}>
          {carrier.logo ? (
            <img
              class="carrier-logo"
              src={carrier.logo}
              alt=""
              decoding="async"
              style={carrier.logoScale ? `--logo-scale:${carrier.logoScale}` : undefined}
            />
          ) : carrier.name}
          {carrier.note && <span class="chip-tag">{carrier.note}</span>}
        </span>
      )))}
    </div>
  </div>
</div>
