---
import { site, footerNav, legalNav, utilityNav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-cols">
      {
        footerNav.map((group) => (
          <div>
            <h2>{group.heading}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li>Mansfield, TX</li>
          <li><a href={utilityNav[1].href}>{utilityNav[1].label}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. Licensed nationwide.</p>
      <nav aria-label="Legal">
        {legalNav.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </div>
</footer>
