---
// The homepage FAQ, plus the closing CTA band.
//
// Both are now the shared components — Faq emits the FAQPage schema alongside
// the visible copy, which is what keeps the two from drifting apart (they used
// to be maintained as two separate lists in two files). CtaBand carries the
// call, text and schedule actions and the note form.
import Faq from '../Faq.astro';
import CtaBand from '../CtaBand.astro';

const faqs = [
  {
    q: 'Does it cost extra to use an agent?',
    a: 'No. Premiums are set by the carriers — you pay the same with or without me. Carriers pay me, so my help is free to you.',
  },
  {
    q: 'Do we have to meet in person?',
    a: 'Not at all. Most of my clients I’ve never met in person — we handle everything by phone, and many have been with me for years.',
  },
  {
    q: 'What’s the difference between Supplement and Advantage?',
    a: 'Supplement works alongside Original Medicare with freedom to see any Medicare doctor; Advantage is an all-in-one alternative with networks and often lower premiums. Which fits depends on your doctors, prescriptions, and budget — that’s what we’d talk through.',
  },
  {
    q: 'Can you help in my state?',
    a: 'I’m licensed in 43 states. Ask me — if I can’t help, I’ll say so.',
  },
];
---

<section class="section" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <p class="eyebrow">Questions</p>

    <div class="section-intro">
      <h2 id="faq-heading">Questions I hear every week.</h2>
    </div>

    <Faq items={faqs} schema />

    <div class="actions actions--stack">
      <a class="btn btn--ghost" href="/medicare/education">Read the guides</a>
      <a class="btn btn--ghost" href="/medicare/resources">Official Medicare resources</a>
    </div>
  </div>
</section>

<CtaBand
  heading="Let’s talk. No pressure, no cost — just answers."
  copy="Call, text, or book a time — whichever suits you. There’s nothing to decide on the first conversation."
/>
