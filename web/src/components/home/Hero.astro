---
// Hero: full-bleed photo + deep-navy overlay. Kept deliberately calm: headline,
// subhead, rotating review chip, then the quick-start box stretching the full
// container width (same edges as the header's logo/CTA). Everything above the
// fold at every viewport — the --hero-gap mechanism handles compression.
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <h1 id="hero-heading">Medicare made <span class="accent">simple</span> — with a real person in your corner.</h1>

    <p class="hero-sub">
      I’m Lisa. I help people across the country with Medicare, dental, and vision
      coverage — free — and I stay with you long after you enroll.
    </p>

    <!-- Rotating review chip (one visible at a time; rotation pauses under reduced motion) -->
    <div class="review-chip">
      <!-- REPLACE: real review -->
      <blockquote class="is-active">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>“Lisa made Medicare finally make sense to me.”</span>
        <span class="who">— Margaret, TX</span>
      </blockquote>
      <!-- REPLACE: real review -->
      <blockquote>
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>“She found the right plan and still checks in every year.”</span>
        <span class="who">— James, OK</span>
      </blockquote>
      <!-- REPLACE: real review -->
      <blockquote>
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>“I call Lisa, not an 800 number. That’s why I stay.”</span>
        <span class="who">— Diane, MO</span>
      </blockquote>
    </div>

    <!-- Quick-start bar: full container width, one select + one button, no data collected -->
    <form class="quickstart">
      <p class="quickstart-title">Let’s find your starting point</p>
      <div class="field">
        <label for="quickstart-topic">What do you need help with?</label>
        <select id="quickstart-topic" name="topic">
          <option value="medicare">Medicare</option>
          <option value="dental">Dental &amp; Vision</option>
          <option value="other">Something else</option>
        </select>
      </div>
      <button class="btn btn--gold" type="submit">Get free help</button>
    </form>
  </div>
</section>
