---
// Hero: a warm field of colour with one composed statement group, left-aligned
// to the logo — no stock humans, per the imagery rule.
//
// The lockup holds the display line, the "I'm Lisa" sentence, and the Talk to
// Lisa action, all left-aligned to the logo: headline + sentence at the
// top-left, the action + microline pinned to the bottom-left (owner's request,
// 2026-08). The old sub-statement ("with a real person in
// your corner") is gone. So are the rotating review capsule and the
// quick-start box that used to sit on the hero's floor: both were already
// display:none at the owner's request, and the capsule carried placeholder
// quotes that must never ship — real proof lives in the Reviews section,
// which pulls from Google. On phones the quick-start survives as the
// NeedsSelector section directly under the hero.
import { site } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  {/* Background footage under the navy wash. Decorative, so it is hidden from
      assistive tech and carries no controls. The poster is a CSS background on
      the wrapper rather than the video's `poster` attribute, so the still frame
      is what shows whenever the video doesn't play at all — reduced motion,
      Save-Data, autoplay blocked, or a browser that can't decode either file. */}
  <div class="hero-media" aria-hidden="true">
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      disablepictureinpicture
    ></video>
  </div>

  <div class="container">
    <div class="hero-lockup">
      <h1 id="hero-heading">
        {/* Stacked deliberately — the break is part of the composition, not a
            wrap, so it holds at every width. */}
        <span class="display-xl">Medicare<br />made simple</span>
      </h1>

      <p class="hero-sub">
        I’m Lisa. I help people across the country with Medicare, health, dental
        and vision coverage, free, and I stay with you long after you enroll.
      </p>

      <a class="btn btn--accent" href={site.phoneHref}>Talk to Lisa · {site.phone}</a>
      <p class="microline">Calling connects you with Lisa, a licensed insurance agent.</p>
    </div>
  </div>
</section>

<script is:inline>
  /* Hero background video loader.
     The <video> ships with NO sources, so nothing downloads until this decides
     it should. That is the whole point: on a phone with Save-Data, or for a
     visitor who asked for reduced motion, the page costs one 27KB still instead
     of a video file.

     It also waits for `load`, so the footage never competes with the hero's own
     paint — the poster and the navy wash are on screen first either way. */
  (function () {
    var video = document.querySelector('.hero-video');
    if (!video) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var saveData = navigator.connection && navigator.connection.saveData;
    if (reduceMotion || saveData) return; // poster only — nothing is fetched

    function start() {
      // One MP4 for every size — the source clip ships as a single MP4. If a
      // smaller mobile encode or a WebM is produced later, branch on
      // window.matchMedia('(max-width: 899px)') here and append extra <source>s
      // before the MP4 (the browser picks the first it can play).
      var source = document.createElement('source');
      source.type = 'video/mp4';
      source.src = '/media/hero.mp4';
      video.appendChild(source);

      video.addEventListener('playing', function () {
        video.dataset.ready = 'true'; // fades it in over the poster
      });

      video.load();
      // Autoplay can still be refused; the poster simply stays put if so.
      var attempt = video.play();
      if (attempt && attempt.catch) attempt.catch(function () {});
    }

    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start);
  })();
</script>
