---
// Medicare made simple: Supplement vs Advantage, no prices, no superlatives.
// The two explainers read as tall tinted tiles (.cards--tiles), and each now
// links to its own page rather than dead-ending on the homepage.
import { site } from '../../data/site';
---

<section class="section" id="medicare" aria-labelledby="medicare-heading">
  <div class="container">
    <p class="eyebrow">Medicare</p>

    <div class="section-intro">
      <h2 id="medicare-heading">Medicare explained your way.</h2>
      <p class="lead">
        Most people come to me with one big question: Medicare Supplement or
        Medicare Advantage plan? Here’s the short version.
      </p>
    </div>

    <div class="cards cards--2 cards--tiles">
      <article class="card">
        {/* Non-breaking space ties the parenthetical to the word before it, so
            the heading can't wrap to a lone "(Medigap)" on a narrow tile. Same
            words, just a break the line can't take. */}
        <h3>Medicare Supplement&nbsp;(Medigap)</h3>
        <p>
          Medicare Supplement helps cover Medicare’s out-of-pocket costs,
          including deductibles, copays, and coinsurance.
        </p>
        <a class="btn btn--ghost" href="/medicare/supplement">About Supplement plans</a>
      </article>
      <article class="card">
        {/* Both spaces non-breaking: binding only the first one still let the
            line break inside the parenthetical, leaving "C)" stranded. */}
        <h3>Medicare Advantage&nbsp;(Part&nbsp;C)</h3>
        <p>
          An all-in-one plan with extra benefits, lower premiums, and a network
          of participating providers.
        </p>
        <a class="btn btn--ghost" href="/medicare/advantage">About Advantage plans</a>
      </article>
    </div>

    <div class="medicare-cta">
      <p>
        Finding the right plan starts with a list of your doctors and
        prescriptions. I’ll help you find the right one.
      </p>
      <a class="btn btn--accent" href={site.phoneHref}>Talk to Lisa · {site.phone}</a>
      <p class="microline">Calling connects you with Lisa, a licensed insurance agent.</p>
    </div>

    <!-- VIDEO ASSET PENDING: swap this frame for the real 3-minute explainer -->
    <div class="video-placeholder" role="img" aria-label="Video coming soon: Advantage versus Supplement in three minutes">
      <span class="play-ring" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
      <p>Advantage vs Supplement in 3 minutes — coming soon</p>
    </div>
  </div>
</section>
