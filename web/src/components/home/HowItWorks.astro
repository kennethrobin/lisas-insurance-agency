---
// How it works with Lisa — the reference's dark feature panel: media block on
// the left with a small white badge and a white overlay card (title + required
// phone microline + call button); numbered rows with gold circle arrows right.
import { site } from '../../data/site';

const steps = [
  {
    title: 'Call or text me',
    copy: 'Free, no pressure. Tell me about your doctors, prescriptions, and budget.',
  },
  {
    title: 'I shop my carriers',
    copy: 'I compare the plans I represent and explain the trade-offs in plain English.',
  },
  {
    title: 'You’re covered — and kept',
    copy: 'I handle the enrollment and stay your agent for the life of the policy.',
  },
];
---

<section class="section" id="how-it-works" aria-labelledby="how-heading">
  <div class="container">
    <div class="how-panel">
      <div class="how-media">
        <span class="how-badge">Free help</span>

        <div class="how-card">
          <h3>You call me — not a call center</h3>
          <p>Calling connects you with Lisa, a licensed insurance agent.</p>
          <a class="btn btn--gold" href={site.phoneHref}>Talk to Lisa</a>
        </div>
      </div>

      <div class="how-content">
        <p class="eyebrow">How it works</p>
        <h2 id="how-heading">How it works with Lisa.</h2>

        <ol class="steps">
          {steps.map((s) => (
            <li>
              <div class="step-text">
                <h3>{s.title}</h3>
                <p>{s.copy}</p>
              </div>
              <span class="step-arrow" aria-hidden="true">↗</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
