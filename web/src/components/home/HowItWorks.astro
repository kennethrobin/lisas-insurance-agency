---
// How it works with Lisa — 3 steps, set as a numbered process row.
//
// The "Schedule a call" action resolves through links.ts: with a booking URL it
// links there, and without one it becomes the text path with wording that
// matches, so the button is never a dead control.
import { site } from '../../data/site';
import { links, isPending, externalAttrs } from '../../data/links';

const steps = [
  {
    title: 'Call or text me',
    copy: 'Free, no pressure. Tell me about your doctors, prescriptions, and budget.',
  },
  {
    title: 'I shop my carriers',
    copy: 'I compare the plans I represent and explain the trade-offs in plain English.',
  },
  {
    title: 'You’re covered — and kept',
    copy: 'I handle the enrollment and stay your agent for the life of the policy.',
  },
];

const bookingPending = isPending(links.booking);
---

<section class="section" id="how-it-works" aria-labelledby="how-heading">
  <div class="container">
    <p class="eyebrow">How it works</p>

    <div class="section-intro">
      <h2 id="how-heading">How it works with Lisa.</h2>
    </div>

    <ol class="steps">
      {steps.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.copy}</p>
        </li>
      ))}
    </ol>

    <div class="actions actions--stack">
      <a class="btn btn--accent" href={site.phoneHref}>Talk to Lisa · {site.phone}</a>
      {bookingPending ? (
        /* TODO: links.booking — no scheduling page yet, so this is the text
           path with wording that matches rather than a button that opens
           nothing. */
        <a class="btn btn--ghost" href={site.smsHref}>Text me a good time</a>
      ) : (
        <a class="btn btn--ghost" href={links.booking} {...externalAttrs}>Schedule a call</a>
      )}
    </div>
    <p class="microline">Calling connects you with Lisa, a licensed insurance agent.</p>
  </div>
</section>
