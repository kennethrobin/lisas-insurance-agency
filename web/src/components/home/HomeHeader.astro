---
// Homepage header: transparent over the hero, solid white after ~40px of scroll
// (behavior wired in the homepage's inline script). Phone becomes a gold
// tap-to-call pill on the white state.
//
// The menu is driven by `mainNav` in src/data/site.ts (the IA source of truth),
// so it links to real canonical routes and stays in sync as pages ship. Links
// are always visible at every width — no hamburger — and the items that have
// sub-pages use a lightweight dropdown disclosure rather than a full drawer.
import { site, mainNav } from '../../data/site';
---

<header class="site-header">
  <div class="container">
    <a class="wordmark" href="/">{site.name}</a>

    <nav class="site-nav" aria-label="Main menu">
      <ul class="site-nav-list">
        {
          mainNav.map((item, i) =>
            item.groups ? (
              <li class="nav-item" data-nav-dd>
                <button
                  class="nav-top"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`home-dd-${i}`}
                >
                  {item.label}
                  <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </button>
                <div class="nav-dropdown" id={`home-dd-${i}`}>
                  {item.groups.map((group) => (
                    <div class="nav-dd-group">
                      <p class="nav-dd-heading">{group.heading}</p>
                      <ul>
                        {group.links.map((link) => (
                          <li>
                            <a href={link.href}>{link.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </li>
            ) : (
              <li class="nav-item">
                <a class="nav-top" href={item.href}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="header-right">
      <a
        class="header-phone"
        href={site.phoneHref}
        aria-label={`Call ${site.phone}. Calling connects you with Lisa, a licensed insurance agent.`}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8a15.3 15.3 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/>
        </svg>
        {site.phone}
      </a>

      <a class="btn btn--gold header-cta" href={site.cta.href}>{site.cta.label}</a>
    </div>
  </div>
</header>
