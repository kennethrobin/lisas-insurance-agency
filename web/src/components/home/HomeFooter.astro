---
// Homepage footer — required Medicare disclaimers ship verbatim, 14px minimum,
// readable on navy. Contact details come from site.ts (single source of truth).
import { site, legalNav } from '../../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="wordmark">{site.name}</p>
        <p class="mission">
          Independent Medicare, dental &amp; vision help — free, and for the life
          of your policy.
        </p>

        <div class="footer-contact">
          <a href={site.phoneHref}>☎ {site.phone}</a>
          <a href="mailto:lisa@lisasinsuranceagency.com">lisa@lisasinsuranceagency.com</a>
          <!-- CONFIRM: business hours -->
          <span>Hours: [CONFIRM]</span>
          <p class="microline">Calling connects you with Lisa, a licensed insurance agent.</p>
        </div>

        <div class="footer-social">
          <!-- PLACEHOLDER LINKS: real social profiles -->
          <a href="#" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.6 1.7-1.6h1.5V4.2c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.4-3.8 3.9v2.8H8v3.2h2.7v8z"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1zm0 1.8c-3.1 0-3.5 0-4.8.1-1.1.1-1.5.2-1.8.3-.5.2-.8.4-1.1.7-.3.3-.5.6-.7 1.1-.1.3-.3.7-.3 1.8-.1 1.3-.1 1.7-.1 4.8s0 3.5.1 4.8c.1 1.1.2 1.5.3 1.8.2.5.4.8.7 1.1.3.3.6.5 1.1.7.3.1.7.3 1.8.3 1.3.1 1.7.1 4.8.1s3.5 0 4.8-.1c1.1-.1 1.5-.2 1.8-.3.5-.2.8-.4 1.1-.7.3-.3.5-.6.7-1.1.1-.3.3-.7.3-1.8.1-1.3.1-1.7.1-4.8s0-3.5-.1-4.8c-.1-1.1-.2-1.5-.3-1.8-.2-.5-.4-.8-.7-1.1-.3-.3-.6-.5-1.1-.7-.3-.1-.7-.3-1.8-.3-1.3-.1-1.7-.1-4.8-.1zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 8.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0z"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.31h4.52V23H.24zM8.34 8.31h4.33v2h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.92V23h-4.51v-7.13c0-1.7-.03-3.89-2.37-3.89-2.37 0-2.73 1.85-2.73 3.76V23H8.34z"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12z"/></svg>
          </a>
        </div>
      </div>

      <nav class="footer-col" aria-label="Quick links">
        <h3>Quick links</h3>
        <ul>
          <li><a href="#medicare">Medicare</a></li>
          <li><a href="#dental">Dental &amp; Vision</a></li>
          <li><a href="#why-me">Why me</a></li>
          <li><a href="#reviews">Reviews</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <h3>Already my client?</h3>
        <ul>
          <!-- PLACEHOLDER LINK: /policyholders page not built yet -->
          <li><a href="/policyholders">Policyholder resources</a></li>
        </ul>
      </div>
    </div>

    <p class="footer-review-row">
      <span class="mark" aria-hidden="true">★</span> Leave a review:
      <!-- PLACEHOLDER LINKS: real review URLs -->
      <a href="#" target="_blank" rel="noopener">Google</a> ·
      <a href="#" target="_blank" rel="noopener">Facebook</a>
    </p>

    <div class="footer-disclaimers">
      <p>
        We do not offer every plan available in your area. Any information we
        provide is limited to those plans we do offer in your area. Please contact
        Medicare.gov or 1-800-MEDICARE to get information on all of your options.
      </p>
      <p>
        Not affiliated with or endorsed by the U.S. government or the federal
        Medicare program.
      </p>
      <p>
        Secure online dental enrollment is available in 43 states. Coverage is
        currently unavailable in CT, VT, UT, HI, WY, WV, and RI.
      </p>
    </div>

    <div class="footer-legal">
      {legalNav.map((link) => <a href={link.href}>{link.label}</a>)}
      <span>© {site.name}</span>
    </div>
  </div>
</footer>
