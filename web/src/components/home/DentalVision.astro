---
// Dental & Vision — the box that opens the comparison chart.
//
// "Compare dental plans" lands on /dental-insurance#compare, which is where the
// chart lives, rather than dropping people at the top of the page to hunt for
// it. The carrier strip sits underneath as proof there is something to compare.
import CarrierStrip from '../CarrierStrip.astro';
import DentalEligibility from './DentalEligibility.astro';

/* PLACEHOLDER LOGOS: in-brand name chips until real carrier artwork is
   licensed. Carrier marks are trademarked; a fake logo is worse than none. */
const carriers = [
  { name: 'Ameritas', note: 'Large network' },
  { name: 'Manhattan Life' },
  { name: 'Allstate' },
  { name: 'Healthspring' },
  { name: 'Aetna' },
  { name: 'Mutual of Omaha' },
];
---

<section class="section section--navy" id="dental" aria-labelledby="dental-heading">
  <div class="container">
    <p class="eyebrow">Dental &amp; Vision</p>

    <div class="section-intro">
      <h2 id="dental-heading">Looking for dental or vision coverage? You can begin any time of year.</h2>
    </div>

    <DentalEligibility />

    <div class="reviews-actions">
      <a class="btn btn--accent" href="/dental-insurance#compare">Compare dental plans</a>
      <a class="btn btn--ghost" href="#contact">Talk to Lisa first</a>
    </div>

    <CarrierStrip label="Carrier partners" carriers={carriers} />

    <p class="reviews-footnote">
      Online enrollment available in 43 states. Not available in CT, VT, UT, HI, WY, WV, RI.
    </p>
  </div>
</section>
