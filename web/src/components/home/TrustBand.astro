---
// Trust band.
//
// The star item shows a fixed "5 star rating" (owner's request). If you later
// want it driven by the live Google rating again, restore the build-time
// fetchGoogleReviews() call from googleReviews.ts and render its value here.
---

<section class="trust-band" aria-label="Why you can trust Lisa">
  <div class="container">
    <ul>
      <li>
        <svg class="mark" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
        </svg>
        Licensed in 43 states
      </li>
      <li>
        <svg class="mark" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
        </svg>
        A broker, I compare carriers
      </li>
      <li>
        <span class="mark" aria-hidden="true">★</span>
        5 star rating
      </li>
      <li>
        <svg class="mark" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
        </svg>
        Free help, same premium either way
      </li>
    </ul>
  </div>
</section>
