---
// Honest trust band: no invented stats.
//
// The Google rating comes from the same build-time Places fetch the Reviews
// section uses (one API call per build, cached in googleReviews.ts). Until the
// key and Place ID are configured it keeps the marked [X.X] placeholder, which
// is deliberately unshippable-looking rather than a made-up number.
import { fetchGoogleReviews } from '../../data/googleReviews';

const google = await fetchGoogleReviews();
const rating =
  google?.rating != null ? `${google.rating.toFixed(1)} Google rating` : null;
---

<section class="trust-band" aria-label="Why you can trust Lisa">
  <div class="container">
    <ul>
      <li>
        <svg class="mark" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
        </svg>
        Licensed in 43 states
      </li>
      <li>
        <svg class="mark" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
        </svg>
        A broker, I compare carriers
      </li>
      <li>
        <span class="mark" aria-hidden="true">★</span>
        {rating ? (
          rating
        ) : (
          <>
            <!-- CONFIRM: renders once GOOGLE_PLACES_API_KEY + GOOGLE_PLACE_ID are set -->
            [X.X] Google rating
          </>
        )}
      </li>
      <li>
        <svg class="mark" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
        </svg>
        Free help, same premium either way
      </li>
    </ul>
  </div>
</section>
