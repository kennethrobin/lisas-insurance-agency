    <ul class="stat-strip">
      <li class="stat">
        <span class="stat-lead">43</span>
        <span class="stat-label">states licensed</span>
      </li>
      <li class="stat">
        <span class="stat-lead">Free</span>
        <span class="stat-label">help — same premium either way</span>
      </li>
      <li class="stat">
        <!-- CONFIRM: real Google rating -->
        <span class="stat-lead">★ [X.X]</span>
        <span class="stat-label">Google rating</span>
      </li>
      <li class="stat">
        <span class="stat-lead">Independent</span>
        <span class="stat-label">many top carriers</span>
      </li>
    </ul>
  </div>
</section>
