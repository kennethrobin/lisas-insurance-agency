---
// Carrier band: the dark-blue strip directly under the homepage hero.
//
// It used to hold three text credentials (licensed states, broker, Google
// rating). At the owner's request (2026-10) it now carries the rolling logo
// scroll of medical carrier partners instead, in Lisa's order of importance.
// The dental carriers stay on the Dental & Vision page. The Google rating is
// still shown in the Reviews section further down the page.
import CarrierStrip from '../CarrierStrip.astro';
import { carrierLogos as logo } from '../../data/carriers';

/* Order of importance, supplied by Lisa. Keep it in this order. */
const carriers = [
  { name: 'UnitedHealthcare', ...logo.unitedHealthcare },
  { name: 'Aetna', ...logo.aetna },
  { name: 'Healthspring', ...logo.healthspring },
  { name: 'Mutual of Omaha', ...logo.mutualOfOmaha },
  { name: 'Aflac', ...logo.aflac },
  { name: 'Humana', ...logo.humana },
  { name: 'Devoted Health', ...logo.devotedHealth },
];
---

<section class="trust-band trust-band--carriers" aria-labelledby="carrier-band-heading">
  <div class="container">
    <h2 id="carrier-band-heading" class="carrier-band-label">Carrier partners</h2>
    {/* The rolling strip is aria-hidden (it repeats every name for the loop),
        so assistive tech gets the same list once, here. */}
    <ul class="visually-hidden">
      {carriers.map((carrier) => <li>{carrier.name}</li>)}
    </ul>
    <CarrierStrip carriers={carriers} />
  </div>
</section>
