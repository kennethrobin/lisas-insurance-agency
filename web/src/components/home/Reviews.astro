---
// Reviews — stacked cards (simpler and calmer than a carousel for this audience).
// Every review below is a placeholder awaiting real, verbatim client reviews.
//
// The review buttons come from links.ts and only render once a real URL exists,
// so this row can never show a button that goes nowhere. Google, Facebook and X;
// no Instagram. Room is left for more — add a key to links.ts and a line here.
import { links, isPending, externalAttrs } from '../../data/links';

const reviewSites = [
  { label: 'Google', href: links.reviewGoogle, star: true },
  { label: 'Facebook', href: links.reviewFacebook },
  { label: 'X', href: links.reviewX },
  // Room for more: add the key to links.ts, then a line here.
].filter((entry) => !isPending(entry.href));
---

<section class="section section--navy" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <p class="eyebrow">Reviews</p>

    <div class="section-intro">
      <h2 id="reviews-heading">My clients say it better than I can.</h2>
    </div>

    <div class="cards cards--3">
      <!-- REPLACE: real review, verbatim -->
      <article class="card review-card">
        <p class="stars" aria-hidden="true">★★★★★</p>
        <blockquote>
          “Lisa walked me through every option and never once rushed me. A year
          later she still answers when I call.”
        </blockquote>
        <footer>Margaret, TX</footer>
      </article>

      <!-- REPLACE: real review, verbatim -->
      <article class="card review-card">
        <p class="stars" aria-hidden="true">★★★★★</p>
        <blockquote>
          “We moved states and Lisa handled the whole switch. I didn’t have to
          call anyone else.”
        </blockquote>
        <footer>James, OK</footer>
      </article>

      <!-- REPLACE: real review, verbatim -->
      <article class="card review-card">
        <p class="stars" aria-hidden="true">★★★★★</p>
        <blockquote>
          “She explained Supplement versus Advantage in ten minutes better than
          anything I’d read in months.”
        </blockquote>
        <footer>Diane, MO</footer>
      </article>
    </div>

    {reviewSites.length > 0 ? (
      <div class="reviews-actions">
        {reviewSites.map((entry) => (
          <a class="btn btn--ghost" href={entry.href} {...externalAttrs}>
            {entry.star ? `★ Leave a review on ${entry.label}` : entry.label}
          </a>
        ))}
      </div>
    ) : (
      /* TODO: links.reviewGoogle / reviewFacebook / reviewX. Until at least one
         is real, the row is a call to action rather than a set of dead buttons. */
      <div class="reviews-actions">
        <a class="btn btn--ghost" href="/contact">Share Your Experience</a>
      </div>
    )}

    <p class="reviews-footnote">Real Client Experiences</p>
  </div>
</section>
