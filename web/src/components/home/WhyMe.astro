---
// "Life of the policy" — 4 feature cards with small outlined icon tiles.
//
// Copy is client-supplied (Revision 4 — the Pass 2 notes were jumbled, this is
// the corrected set). Don't reword without going back to the owner.
const reasons = [
  {
    title: 'Loyal To You',
    copy: 'Partnering with trusted carriers, I compare options to find coverage that fits your needs, not theirs.',
  },
  {
    title: 'No Added Cost To You',
    copy: 'You pay the same premium. I help compare options and find the coverage that best fits your needs.',
  },
  {
    title: 'Your Medicare Advisor',
    copy: 'Your Medicare needs may change over time. I provide ongoing guidance and annual reviews to help you stay informed.',
  },
  {
    title: 'Enrollment Options',
    copy: 'Enroll online whenever you’re ready, or walk through it with me first. Both doors are open, and you have professional guidance either way.',
  },
];
---

<section class="section section--navy" id="why-me" aria-labelledby="why-heading">
  <div class="container">
    <p class="eyebrow">Why Lisa</p>

    <div class="section-intro">
      <h2 id="why-heading">You get a licensed advisor for the life of your policy.</h2>
      <p class="lead">
        Since 2007, I’ve helped clients navigate their options by comparing
        multiple carriers to find the best options available.
      </p>
    </div>

    <div class="cards cards--4">
      {reasons.map((r) => (
        <article class="card">
          <span class="check-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
            </svg>
          </span>
          <h3>{r.title}</h3>
          <p>{r.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>
