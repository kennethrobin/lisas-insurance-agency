---
// "Life of the policy" — 4 feature cards with small outlined icon tiles.
//
// Copy here is client-approved and compliance-reviewed (Revision 2, Pass 2).
// An earlier draft avoided the word "independent" as industry vocabulary; the
// approved text uses it deliberately, so that note no longer applies. Do not
// reword these cards without going back through review.
const reasons = [
  {
    title: 'Loyal to you, not a carrier',
    copy: 'As an independent licensed insurance agent, I’m contracted with multiple carriers. I’m not employed by any single company, so no one insurer influences my recommendations. Instead, I compare plans side by side and present the options that best fit your needs and budget, helping you make a confident, well-informed decision.',
  },
  {
    title: 'Your Premium Doesn’t Change',
    copy: 'Plan premiums are set by the carrier and filed with the state, they’re identical whether you enroll on your own or with my help. What I bring is the legwork: comparing the plans you’re eligible for and finding a competitive rate on coverage that actually fits what you need.',
  },
  {
    title: 'A Year-Round Advisor',
    copy: 'Your coverage shouldn’t be a one-time decision. I’m available to review your plan with you annually and help you make changes when your health, your prescriptions, or your budget change. With a Medicare Supplement, you may qualify to make a change at any time of year. With a Medicare Advantage plan, changes are generally made during the Annual Enrollment Period (AEP) each fall, during the Medicare Advantage Open Enrollment Period from January 1 through March 31, or if you qualify for a Special Enrollment Period (SEP).',
  },
  {
    title: 'Enrollment Options',
    copy: 'Enroll online whenever you’re ready, or walk through it with me first. Both doors are open, and you have professional guidance either way.',
  },
];
---

<section class="section section--navy" id="why-me" aria-labelledby="why-heading">
  <div class="container">
    <p class="eyebrow">Why Lisa</p>

    <div class="section-intro">
      <h2 id="why-heading">
        You get a licensed advisor for the life of your policy, someone who knows
        your coverage and is still here when it needs to change.
      </h2>
      {/* COMPLIANCE-REVIEWED (HP-07). Do not add "top rated", "best" or
          "most competitive" to this line under any circumstances. */}
      <p class="lead">
        As a licensed agent since 2007, I shop multiple carriers to find the
        right coverage at a competitive rate for every client.
      </p>
    </div>

    <div class="cards cards--4">
      {reasons.map((r) => (
        <article class="card">
          <span class="check-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
            </svg>
          </span>
          <h3>{r.title}</h3>
          <p>{r.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>
