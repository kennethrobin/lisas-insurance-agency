---
// "Life of the policy" — 4 feature cards with small outlined icon tiles.
//
// The word "independent" is gone on purpose. It's industry vocabulary that
// means nothing to someone buying their first plan, and it invites the follow-up
// question it was meant to answer. The plain version — who I'm loyal to, and who
// pays me — is what people actually want to know, so the card says that instead.
const reasons = [
  {
    title: 'Loyal to you, not a carrier',
    copy: 'I’m a broker. No single insurance company employs me or decides what I recommend — I represent a number of them and compare them for you.',
  },
  {
    title: 'Costs you nothing',
    copy: 'Premiums are set by the carriers. You pay exactly the same with me or without me, because the carriers pay me — not you.',
  },
  {
    title: 'Lifetime service',
    copy: 'Billing questions, claim issues, a move to a new state — you call me, not a call centre. For as long as you hold the policy.',
  },
  {
    title: 'Out of your way',
    copy: 'Enroll online in minutes, or talk it through with me first. Both doors are open, and neither one costs more.',
  },
];
---

<section class="section section--navy" id="why-me" aria-labelledby="why-heading">
  <div class="container">
    <p class="eyebrow">Why Lisa</p>

    <div class="section-intro">
      <h2 id="why-heading">You get me — for the life of your policy.</h2>
      <p class="lead">
        An agent works for one company. A broker works for you. I’m the second
        one, and it costs you nothing to have me in your corner.
      </p>
    </div>

    <div class="cards cards--4">
      {reasons.map((r) => (
        <article class="card">
          <span class="check-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
            </svg>
          </span>
          <h3>{r.title}</h3>
          <p>{r.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>
