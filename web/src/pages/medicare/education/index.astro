---
/**
 * Medicare Education — the blog hub.
 *
 * Lists everything in the `blog` collection, newest first. Drafts are filtered
 * out here rather than deleted, so a half-written guide can live in the repo.
 */
import Page from '../../../layouts/Page.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Subscribe from '../../../components/Subscribe.astro';
import { getCollection } from 'astro:content';

const title = 'Medicare Education: Guides & Articles | Lisa’s Insurance Agency';
const description =
  'Plain-language guides to Medicare: what to do when you turn 65, what Original Medicare doesn’t cover, and the decisions worth getting right the first time.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Page
  title={title}
  description={description}
  rawTitle
  eyebrow="Medicare · Education"
  heading="Helpful Guides Before You Choose a Plan"
  intro="Clear, easy to understand information about Medicare topics, coverage options, and questions you should consider before making a decision."
>
  <section class="section" id="guides" aria-labelledby="guides-heading">
    <div class="container">
      <p class="eyebrow">The guides</p>

      <div class="section-intro">
        <h2 id="guides-heading">Everything published so far.</h2>
      </div>

      {posts.length === 0 ? (
        <div class="callout callout--note">
          <h3>Nothing published yet</h3>
          <p>The first guides are being written. Call or text in the meantime.</p>
        </div>
      ) : (
        <div class="post-list">
          {posts.map((post) => (
            <article class="post-row">
              <div>
                <h3>
                  <a href={`/medicare/education/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
              <p class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {dateFormat.format(post.data.date)}
                </time>
                {post.data.tag && <> · {post.data.tag}</>}
              </p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section--navy" id="subscribe" aria-labelledby="subscribe-heading">
    <div class="container">
      {/* ED-03 replaced this block's eyebrow, heading and note with a single
          heading and paragraph. The eyebrow is dropped rather than repeated:
          "Stay Informed" above "Stay Informed" reads as a bug. */}
      <div class="section-intro">
        <h2 id="subscribe-heading">Stay Informed</h2>
        <p class="lead">
          Get notified when new resources and helpful information become available.
          Your information stays private and is only used for updates.
        </p>
      </div>

      <Subscribe />
    </div>
  </section>

  <CtaBand
    heading="Read something you want to ask about?"
    copy="That’s what these are for. Call or text and we’ll pick up wherever the article left off."
  />
</Page>
