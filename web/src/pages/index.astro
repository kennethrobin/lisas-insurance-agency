---
/**
 * Homepage — the first route designed for real (replaces the nav scaffold stub).
 *
 * Uses Shell (not Base) so the scaffold's global.css never loads here: both
 * stylesheets define `.btn`, and whichever loads last wins, which previously
 * turned the gold capsule CTAs into the scaffold's blue rectangles. This page
 * ships its own chrome and imports only brand.css. Every other route still
 * renders through Base via [...slug].astro.
 */
import Shell from '../layouts/Shell.astro';
import { site } from '../data/site';
import '../styles/brand.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import Hero from '../components/home/Hero.astro';
import NeedsSelector from '../components/home/NeedsSelector.astro';
import TrustBand from '../components/home/TrustBand.astro';
import MedicareSimple from '../components/home/MedicareSimple.astro';
import WhyMe from '../components/home/WhyMe.astro';
import CoveragePaths from '../components/home/CoveragePaths.astro';
import DentalVision from '../components/home/DentalVision.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Reviews from '../components/home/Reviews.astro';
import FaqContact from '../components/home/FaqContact.astro';

const title = 'Medicare, Health, Dental & Vision Agent | Lisa’s Insurance Agency';
const description =
  'Medicare made simple — with a real person in your corner. Free help with Medicare, health, dental & vision plans in 43 states. Talk to Lisa today.';

const agencySchema = {
  '@context': 'https://schema.org',
  '@type': 'InsuranceAgency',
  name: site.name,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  description:
    'Medicare, health, dental & vision help — free, and for the life of your policy.',
  // CONFIRM: replace with the actual list of 43 licensed states
  areaServed: 'United States — licensed in 43 states',
};

// The FAQPage schema now ships from the Faq component alongside the visible
// copy, so the two can't drift apart the way two hand-kept lists did.
---

<Shell title={title} description={description} rawTitle>
  <Fragment slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted Open Sans (variable); font-display: swap declared in brand.css -->
    <link
      rel="preload"
      href="/fonts/OpenSans-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- ASSET PENDING: replace with branded OG image (current file is a plain navy placeholder) -->
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(agencySchema)} />
  </Fragment>

  <SiteHeader />
  <main id="main">
    <Hero />
    {/* Phone-only. The hero's own .quickstart is hidden below 768px and this
        takes its place directly beneath, so the hero keeps one oversized
        moment instead of carrying a form as well. */}
    <NeedsSelector />
    <TrustBand />
    <MedicareSimple />
    <WhyMe />
    <CoveragePaths />
    <DentalVision />
    <HowItWorks />
    <Reviews />
    <FaqContact />
  </main>
  <SiteFooter />
  <MobileCallBar />
</Shell>

<script>
  // Homepage behavior. Small on purpose — no frameworks.
  // The header (height measurement, scrolled state, hamburger drawer) moved into
  // SiteHeader.astro when the header went sitewide; the contact form's handler
  // lives in CtaBand.astro. What's left here is the two homepage-only widgets.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* 1 · Hero review chip: rotate every 6s (skipped under reduced motion) */
  const chips = document.querySelectorAll('.review-chip blockquote');
  if (chips.length > 1 && !reducedMotion.matches) {
    let current = 0;
    setInterval(() => {
      chips[current].classList.remove('is-active');
      current = (current + 1) % chips.length;
      chips[current].classList.add('is-active');
    }, 6000);
  }

  /* 2 · Quick-start: route the visitor to the matching section.
     Two controls share this handler — the hero's <select> on desktop and the
     four radio rows below the hero on a phone. Only one is ever rendered, but
     binding both keeps the routing in one place. */
  const targets: Record<string, string> = {
    medicare: '#medicare',
    health: '#coverage',
    dental: '#dental',
    other: '#contact',
  };

  document
    .querySelectorAll<HTMLFormElement>('.quickstart, .quickstart-form')
    .forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const chosen =
          form.querySelector<HTMLSelectElement>('select')?.value ??
          form.querySelector<HTMLInputElement>('input[name="topic"]:checked')?.value ??
          'other';
        document.querySelector(targets[chosen] ?? '#contact')?.scrollIntoView({
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      });
    });
</script>
