---
/**
 * Homepage — the first route designed for real (replaces the nav scaffold stub).
 *
 * Uses Shell (not Base) so the scaffold's global.css never loads here: both
 * stylesheets define `.btn`, and whichever loads last wins, which previously
 * turned the gold capsule CTAs into the scaffold's blue rectangles. This page
 * ships its own chrome and imports only brand.css. Every other route still
 * renders through Base via [...slug].astro.
 */
import Shell from '../layouts/Shell.astro';
import { site } from '../data/site';
import '../styles/brand.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import Hero from '../components/home/Hero.astro';
import NeedsSelector from '../components/home/NeedsSelector.astro';
import TrustBand from '../components/home/TrustBand.astro';
import MedicareSimple from '../components/home/MedicareSimple.astro';
import WhyMe from '../components/home/WhyMe.astro';
import CoveragePaths from '../components/home/CoveragePaths.astro';
import DentalVision from '../components/home/DentalVision.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Reviews from '../components/home/Reviews.astro';
import FaqContact from '../components/home/FaqContact.astro';

const title = 'Medicare, Health, Dental & Vision Agent | Lisa’s Insurance Agency';
const description =
  'Medicare made simple, with a real person in your corner. Free help with Medicare, health, dental & vision plans in 43 states. Talk to Lisa today.';

const agencySchema = {
  '@context': 'https://schema.org',
  '@type': 'InsuranceAgency',
  name: site.name,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  description:
    'Medicare, health, dental & vision help: free, and for the life of your policy.',
  // CONFIRM: replace with the actual list of 43 licensed states
  areaServed: 'United States, licensed in 43 states',
};

// The FAQPage schema now ships from the Faq component alongside the visible
// copy, so the two can't drift apart the way two hand-kept lists did.
---

<Shell title={title} description={description} rawTitle>
  <Fragment slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted Open Sans (variable); font-display: swap declared in brand.css -->
    <link
      rel="preload"
      href="/fonts/OpenSans-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- ASSET PENDING: replace with branded OG image (current file is a plain navy placeholder) -->
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(agencySchema)} />
  </Fragment>

  <SiteHeader />
  <main id="main">
    <Hero />
    {/* Phone-only (display:none at >=768px): the "what do you need help with"
        quick-start, as four large tap targets directly under the hero. */}
    <NeedsSelector />
    <TrustBand />
    <MedicareSimple />
    <WhyMe />
    <CoveragePaths />
    <DentalVision />
    <HowItWorks />
    <Reviews />
    <FaqContact />
  </main>
  <SiteFooter />
  <MobileCallBar />
</Shell>

<script>
  // Homepage behavior. Small on purpose — no frameworks.
  // The header lives in SiteHeader.astro and the contact card in
  // GetInTouch.astro; the only homepage-only widget left is the phone
  // quick-start under the hero. (The hero's rotating review chip is gone —
  // it carried placeholder quotes, and real proof now comes from Google in
  // the Reviews section.)
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* Quick-start: route the visitor to the matching section. */
  const targets: Record<string, string> = {
    medicare: '#medicare',
    health: '#coverage',
    dental: '#dental',
    other: '#contact',
  };

  document.querySelectorAll<HTMLFormElement>('.quickstart-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const chosen =
        form.querySelector<HTMLInputElement>('input[name="topic"]:checked')?.value ?? 'other';
      document.querySelector(targets[chosen] ?? '#contact')?.scrollIntoView({
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
    });
  });
</script>
