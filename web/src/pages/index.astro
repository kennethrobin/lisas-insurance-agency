---
/**
 * Homepage — the first route designed for real (replaces the nav scaffold stub).
 *
 * Uses Shell (not Base) so the scaffold's global.css never loads here: both
 * stylesheets define `.btn`, and whichever loads last wins, which previously
 * turned the gold capsule CTAs into the scaffold's blue rectangles. This page
 * ships its own chrome and imports only brand.css. Every other route still
 * renders through Base via [...slug].astro.
 */
import Shell from '../layouts/Shell.astro';
import { site } from '../data/site';
import '../styles/brand.css';

import HomeHeader from '../components/home/HomeHeader.astro';
import Hero from '../components/home/Hero.astro';
import TrustBand from '../components/home/TrustBand.astro';
import MedicareSimple from '../components/home/MedicareSimple.astro';
import WhyMe from '../components/home/WhyMe.astro';
import CoveragePaths from '../components/home/CoveragePaths.astro';
import DentalVision from '../components/home/DentalVision.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Reviews from '../components/home/Reviews.astro';
import FaqContact from '../components/home/FaqContact.astro';
import HomeFooter from '../components/home/HomeFooter.astro';

const title = 'Independent Medicare, Dental & Vision Agent | Lisa’s Insurance Agency';
const description =
  'Medicare made simple — with a real person in your corner. Free, independent help with Medicare, dental & vision plans in 43 states. Talk to Lisa today.';

const agencySchema = {
  '@context': 'https://schema.org',
  '@type': 'InsuranceAgency',
  name: site.name,
  telephone: site.phoneHref.replace('tel:', ''),
  email: 'lisa@lisasinsuranceagency.com',
  description:
    'Independent Medicare, dental & vision help — free, and for the life of your policy.',
  // CONFIRM: replace with the actual list of 43 licensed states
  areaServed: 'United States — licensed in 43 states',
};

// Mirrors the visible FAQ copy in FaqContact.astro exactly.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does it cost extra to use an agent?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Premiums are set by the carriers — you pay the same with or without me. Carriers pay me, so my help is free to you.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I have to meet you in person?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Not at all. Most of my clients I've never met in person — we handle everything by phone, and many have been with me for years.",
      },
    },
    {
      '@type': 'Question',
      name: "What's the difference between Supplement and Advantage?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Supplement works alongside Original Medicare with freedom to see any Medicare doctor; Advantage is an all-in-one alternative with networks and often lower premiums. Which fits depends on your doctors, prescriptions, and budget — that's what we'd talk through.",
      },
    },
    {
      '@type': 'Question',
      name: 'Can you help in my state?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "I'm licensed in 43 states. Ask me — if I can't help, I'll say so.",
      },
    },
  ],
};
---

<Shell title={title} description={description} rawTitle>
  <Fragment slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted Open Sans (variable); font-display: swap declared in brand.css -->
    <link
      rel="preload"
      href="/fonts/OpenSans-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- ASSET PENDING: replace with branded OG image (current file is a plain navy placeholder) -->
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(agencySchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <HomeHeader />
  <main id="main">
    <Hero />
    <TrustBand />
    <MedicareSimple />
    <WhyMe />
    <CoveragePaths />
    <DentalVision />
    <HowItWorks />
    <Reviews />
    <FaqContact />
  </main>
  <HomeFooter />
</Shell>

<script>
  // Homepage behavior. Small on purpose — no frameworks.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* 1 · Header: transparent over hero -> solid white after ~40px of scroll */
  const header = document.querySelector<HTMLElement>('.site-header');

  /* Publish the header's real height so the hero's top offset (and the in-body
     scroll anchors) always clear it. The --header-h token is a fixed 76px, but
     the header grows past that once the inline nav wraps to a second row on
     narrow screens, which would otherwise let the hero content slip under it. */
  const syncHeaderHeight = () => {
    if (!header) return;
    document.documentElement.style.setProperty(
      '--header-actual',
      `${header.offsetHeight}px`
    );
  };
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight, { passive: true });
  window.addEventListener('load', syncHeaderHeight);
  if (document.fonts?.ready) document.fonts.ready.then(syncHeaderHeight);

  const syncHeader = () => {
    if (!header) return;
    header.classList.toggle('is-solid', window.scrollY > 40);
  };
  window.addEventListener('scroll', syncHeader, { passive: true });
  syncHeader();

  /* 2 · Primary nav: lightweight dropdowns for the items that have sub-links.
         No hamburger — the links stay visible at every width. */
  const navMenus = document.querySelectorAll<HTMLElement>('[data-nav-dd]');

  const closeMenu = (menu: HTMLElement) => {
    menu.querySelector('button')?.setAttribute('aria-expanded', 'false');
    const dd = menu.querySelector('.nav-dropdown');
    dd?.removeAttribute('data-open');
    dd?.classList.remove('align-right');
  };

  const openMenu = (menu: HTMLElement) => {
    navMenus.forEach((other) => other !== menu && closeMenu(other));
    menu.querySelector('button')?.setAttribute('aria-expanded', 'true');
    const dd = menu.querySelector<HTMLElement>('.nav-dropdown');
    if (!dd) return;
    dd.setAttribute('data-open', 'true');
    // Flip alignment if the panel would spill off the right edge.
    dd.classList.remove('align-right');
    if (dd.getBoundingClientRect().right > window.innerWidth - 8) {
      dd.classList.add('align-right');
    }
  };

  navMenus.forEach((menu) => {
    const button = menu.querySelector('button');
    if (!button) return;
    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    button.addEventListener('click', () => (isOpen() ? closeMenu(menu) : openMenu(menu)));
    menu.addEventListener('mouseenter', () => openMenu(menu));
    menu.addEventListener('mouseleave', () => closeMenu(menu));
    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node)) closeMenu(menu);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') navMenus.forEach(closeMenu);
  });
  document.addEventListener('click', (event) => {
    navMenus.forEach((menu) => {
      if (!menu.contains(event.target as Node)) closeMenu(menu);
    });
  });

  /* 3 · Hero review chip: rotate every 6s (skipped under reduced motion) */
  const chips = document.querySelectorAll('.review-chip blockquote');
  if (chips.length > 1 && !reducedMotion.matches) {
    let current = 0;
    setInterval(() => {
      chips[current].classList.remove('is-active');
      current = (current + 1) % chips.length;
      chips[current].classList.add('is-active');
    }, 6000);
  }

  /* 4 · Quick-start bar: route the visitor to the matching section */
  const quickstart = document.querySelector<HTMLFormElement>('.quickstart');
  quickstart?.addEventListener('submit', (e) => {
    e.preventDefault();
    const select = quickstart.querySelector('select');
    const targets: Record<string, string> = {
      medicare: '#medicare',
      dental: '#dental',
      other: '#contact',
    };
    const target = targets[select?.value ?? 'other'] ?? '#contact';
    document.querySelector(target)?.scrollIntoView({
      behavior: reducedMotion.matches ? 'auto' : 'smooth',
    });
  });

  /* 5 · Contact form: WIRE LATER — posts nowhere yet, shows success state */
  const contactForm = document.querySelector<HTMLFormElement>('.contact-form');
  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!contactForm.reportValidity()) return;
    contactForm.hidden = true;
    const success = document.querySelector('.form-success');
    success?.classList.add('is-visible');
    if (success instanceof HTMLElement) success.focus();
  });
</script>
