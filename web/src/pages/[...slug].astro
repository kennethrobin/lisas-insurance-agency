---
import Page from '../layouts/Page.astro';
import CtaBand from '../components/CtaBand.astro';
import { pageStubs, type PageStub } from '../data/site';

/**
 * Placeholder for the routes that have no designed content yet — the
 * existing-client hub and the legal tail. Every prospect-facing page is a real
 * file now, and a real file always wins over this catch-all.
 *
 * These build on the brand shell like everything else, so an unfinished page
 * still looks like part of the site rather than like a different website.
 */
export function getStaticPaths() {
  return pageStubs.map((stub) => ({
    params: { slug: stub.path.replace(/^\//, '') },
    props: { stub },
  }));
}

const { stub } = Astro.props as { stub: PageStub };
---

<Page
  title={stub.title}
  eyebrow="Lisa's Insurance Agency"
  heading={stub.title}
  intro={stub.note || undefined}
  noindex
>
  <section class="section">
    <div class="container">
      <div class="callout callout--note">
        <h3>This page is still being written</h3>
        <p>
          The content for this page hasn’t been built yet. In the meantime, call
          or text and I’ll take care of it directly. That’s faster than any form
          anyway.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Let’s sort it out on the phone."
    copy="Whatever you needed this page for, I can handle it with you directly."
  />
</Page>
