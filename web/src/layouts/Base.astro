---
/**
 * Scaffold layout: the document Shell plus the site chrome and the placeholder
 * routes' styling. Used by [...slug].astro and 404.astro.
 *
 * Designed pages use Shell directly instead, so global.css doesn't reach them
 * and override the brand styles.
 */
import Shell from './Shell.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<Shell title={title} description={description} noindex={noindex}>
  <Header />
  <main id="main">
    <div class="wrap">
      <slot />
    </div>
  </main>
  <Footer />
</Shell>
